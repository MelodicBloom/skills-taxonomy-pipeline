{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodicbloom.dev/schemas/decision-review.schema.json",
  "title": "MelodicBloom Decision Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "subject", "evidence", "tokens", "strategies", "taste_review", "defense", "bottom_line", "authority"],
  "properties": {
    "review_id": {"type": "string", "minLength": 8},
    "subject": {"type": "object", "required": ["repository", "revision", "decision"], "properties": {"repository": {"type": "string"}, "revision": {"type": "string"}, "decision": {"type": "string"}}, "additionalProperties": false},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind", "source", "observation", "confidence"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "source": {"type": "string"}, "observation": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}},
    "tokens": {"type": "object", "required": ["visual", "strategic", "narrative"], "properties": {"visual": {"type": "object"}, "strategic": {"type": "object"}, "narrative": {"type": "object"}}, "additionalProperties": false},
    "strategies": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "thesis", "choices", "effects", "risks", "opportunities", "tradeoffs", "preserves", "sacrifices"], "properties": {"id": {"type": "string"}, "thesis": {"type": "string"}, "choices": {"type": "array", "items": {"type": "string"}}, "effects": {"type": "array", "items": {"type": "string"}}, "risks": {"type": "array", "items": {"type": "string"}}, "opportunities": {"type": "array", "items": {"type": "string"}}, "tradeoffs": {"type": "array", "items": {"type": "string"}}, "preserves": {"type": "array", "items": {"type": "string"}}, "sacrifices": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "taste_review": {"type": "object", "required": ["coherence", "specificity", "proportion", "restraint", "contextual_fit", "craft", "disciplined_surprise", "anti_taste_findings", "dissent"], "properties": {"coherence": {"type": "number", "minimum": 0, "maximum": 5}, "specificity": {"type": "number", "minimum": 0, "maximum": 5}, "proportion": {"type": "number", "minimum": 0, "maximum": 5}, "restraint": {"type": "number", "minimum": 0, "maximum": 5}, "contextual_fit": {"type": "number", "minimum": 0, "maximum": 5}, "craft": {"type": "number", "minimum": 0, "maximum": 5}, "disciplined_surprise": {"type": "number", "minimum": 0, "maximum": 5}, "anti_taste_findings": {"type": "array", "items": {"type": "string"}}, "dissent": {"type": "string"}}, "additionalProperties": false},
    "defense": {"type": "object", "required": ["central_claim", "strongest_evidence", "strongest_objection", "response", "boundary_conditions", "failure_signal", "mind_change_evidence"], "properties": {"central_claim": {"type": "string"}, "strongest_evidence": {"type": "array", "items": {"type": "string"}}, "strongest_objection": {"type": "string"}, "response": {"type": "string"}, "boundary_conditions": {"type": "array", "items": {"type": "string"}}, "failure_signal": {"type": "string"}, "mind_change_evidence": {"type": "string"}}, "additionalProperties": false},
    "bottom_line": {"type": "object", "required": ["disposition", "recommendation", "confidence", "upside", "downside", "effort", "reversibility", "cost_of_delay", "cost_of_error", "next_evidence"], "properties": {"disposition": {"enum": ["defend", "narrow", "defer", "reject"]}, "recommendation": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "upside": {"type": "string"}, "downside": {"type": "string"}, "effort": {"type": "string"}, "reversibility": {"type": "string"}, "cost_of_delay": {"type": "string"}, "cost_of_error": {"type": "string"}, "next_evidence": {"type": "string"}}, "additionalProperties": false},
    "authority": {"type": "object", "required": ["read_only", "implementation_authorized", "deployment_authorized"], "properties": {"read_only": {"const": true}, "implementation_authorized": {"const": false}, "deployment_authorized": {"const": false}}, "additionalProperties": false}
  }
}